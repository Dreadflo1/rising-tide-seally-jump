# Durable global leaderboard (api/leaderboard.ts)
#
# Set these by adding the free "Upstash" Redis integration to this project
# from the Vercel dashboard: Project -> Storage -> Browse Marketplace ->
# Upstash -> create database -> Connect to Project. Vercel fills these in
# automatically for you on deploy — you don't need to copy real values
# into this file; it's just here so `vercel env pull` / local dev knows
# what's expected.
#
# Until these are set, /api/leaderboard returns 503 and the game falls
# back to a local-only leaderboard automatically (see src/state.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Sign-In (used by api/config.ts and api/account.ts)
# Create an OAuth 2.0 Web Client in Google Cloud Console and add your Vercel
# domain as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
